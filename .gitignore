# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# tipos de tesseract.js (descargados automáticamente)
/spa.traineddata

# datos generados por el pipeline RAG
/data/extracted.json
/data/chunks.json
/data/vectors.json

# typescript
*.tsbuildinfo
next-env.d.ts
